# ==============================================================================
# AI-POWERED CLOUD CRM — PRODUCTION ENVIRONMENT TEMPLATE (.env.cloud.example)
# ==============================================================================
# IMPORTANT:
# - Do NOT commit real secrets (.env.cloud or production .env) to version control.
# - In AWS production, these values are managed via AWS Systems Manager (SSM)
#   Parameter Store and injected into AWS App Runner at runtime.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Application Settings (AWS App Runner)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Database Configuration (Amazon RDS for PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=cloudcrm-postgres-production.c1234567890.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=cloud_crm_db
DB_USER=cloudcrm_admin
DB_PASSWORD=YOUR_STRONG_RDS_PASSWORD_HERE
DB_SSL=true

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Generate a secure 64-character secret using: openssl rand -base64 48
JWT_SECRET=YOUR_PRODUCTION_JWT_SECRET_STRING_HERE
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 4. CORS & Origin Configuration
# ------------------------------------------------------------------------------
# Set to your CloudFront distribution domain or custom production frontend domain
CORS_ORIGIN=https://d123456abcdef8.cloudfront.net
FRONTEND_URL=https://d123456abcdef8.cloudfront.net

# ------------------------------------------------------------------------------
# 5. AWS Cloud Infrastructure Parameters
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_CLOUDFORMATION_STACK_NAME=cloudcrm-production-stack
AWS_S3_FRONTEND_BUCKET=cloudcrm-frontend-static-production-123456789012
AWS_CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC

# ------------------------------------------------------------------------------
# 6. Frontend Build-Time Variables (Vite SPA)
# ------------------------------------------------------------------------------
# Baked into Vite static bundle at S3 deployment time
VITE_API_BASE_URL=https://abcdef1234.us-east-1.awsapprunner.com
